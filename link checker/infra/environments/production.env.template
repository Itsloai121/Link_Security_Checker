# Copy to production.env (git-ignored) and fill in. Values documented in /.env.example
UNMASK_ENVIRONMENT=production
UNMASK_LOG_LEVEL=INFO
UNMASK_HSTS=true                      # you are serving over HTTPS
UNMASK_TRUSTED_PROXY_HOPS=1           # one reverse proxy you control sets X-Forwarded-For
UNMASK_SCAN_RETENTION_HOURS=24
UNMASK_FEED_REFRESH_HOURS=6
# UNMASK_METRICS_TOKEN=               # set a long random value to enable /internal/metrics
# UNMASK_GSB_API_KEY=
# UNMASK_URLHAUS_AUTH_KEY=
