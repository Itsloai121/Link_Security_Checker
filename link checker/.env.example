# Copy to .env (scripts/setup does this) and edit. .env is git-ignored: NEVER commit real secrets.
# Every value is validated at start-up; invalid or unsafe values stop the app with a clear message.

# --- runtime -----------------------------------------------------------------------------------------------
UNMASK_ENVIRONMENT=development        # development | production | test  (production disables API docs and refuses unsafe settings)
UNMASK_HOST=127.0.0.1                 # bind address. Use 0.0.0.0 only behind a firewall / reverse proxy
UNMASK_PORT=8000
UNMASK_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
UNMASK_LOG_JSON=true                  # structured JSON logs (recommended)
UNMASK_DATABASE_PATH=var/unmask.db    # SQLite file. Keep it on a private, backed-up volume in production
UNMASK_AUTO_MIGRATE=false             # true = apply migrations at start-up (handy in development)

# --- analysis behaviour --------------------------------------------------------------------------------------
UNMASK_SCAN_RETENTION_HOURS=24        # reports are deleted automatically after this long
UNMASK_SCAN_DEADLINE_SECONDS=45       # hard limit for one analysis; unfinished tests are reported as "not verified"
UNMASK_MAX_REDIRECTS=8
UNMASK_MAX_URL_LENGTH=2048
UNMASK_WORKER_CONCURRENCY=3           # scans analysed in parallel
UNMASK_QUEUE_SIZE=100                 # waiting scans before new submissions get 503
UNMASK_ENABLE_CLOAKING_PROBE=true     # second fetch with a browser identity, to detect pages that hide from scanners
UNMASK_ENABLE_REGISTRATION_LOOKUP=true  # domain age via public RDAP (sends the domain name to rdap.org / the registry)
UNMASK_ENABLE_IP_INTELLIGENCE=true      # ASN/network lookup via Team Cymru DNS (sends the server IP address)

# --- outbound safety (SSRF) ------------------------------------------------------------------------------------
UNMASK_ALLOWED_FETCH_PORTS=80,443,8080,8443   # the scanner only connects to these destination ports
UNMASK_ALLOW_PRIVATE_NETWORKS=false           # NEVER true outside automated tests: it switches off the private-network block

# --- abuse protection ------------------------------------------------------------------------------------------
UNMASK_RATE_LIMIT_SUBMIT_PER_MINUTE=10
UNMASK_RATE_LIMIT_READ_PER_MINUTE=240
UNMASK_PER_HOST_SCANS_PER_MINUTE=6    # stops the scanner being used to hammer one victim site
UNMASK_TRUSTED_PROXY_HOPS=0           # >0 only if a reverse proxy you control sets X-Forwarded-For (value = number of proxies)
UNMASK_MAX_BODY_BYTES=8192
UNMASK_HSTS=false                     # true when served over HTTPS

# --- threat feeds (see docs/operations/feeds.md for licence terms) --------------------------------------------------
UNMASK_ENABLED_FEEDS=openphish,spamhaus_drop,spamhaus_drop_v6,spamhaus_asndrop
UNMASK_FEED_REFRESH_HOURS=0           # 0 = refresh only with `update-feeds` (cron); e.g. 6 = in-process refresh every 6 hours (also at start-up)
UNMASK_PURGE_INTERVAL_MINUTES=30      # how often expired reports are deleted

# --- optional integrations (secrets: leave empty to disable) -----------------------------------------------------------
# Enabling either sends the checked URLs to that third party. See docs/architecture/security.md.
UNMASK_GSB_API_KEY=                   # Google Safe Browsing Lookup API key
UNMASK_URLHAUS_AUTH_KEY=              # abuse.ch URLhaus Auth-Key (free account)
UNMASK_METRICS_TOKEN=                 # set to expose GET /internal/metrics with "Authorization: Bearer <token>"; empty = endpoint disabled
