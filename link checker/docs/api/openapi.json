{
  "components": {
    "schemas": {
      "CheckCatalogItem": {
        "properties": {
          "category": {
            "enum": [
              "address",
              "journey",
              "reputation",
              "behavior"
            ],
            "title": "Category",
            "type": "string"
          },
          "category_label": {
            "title": "Category Label",
            "type": "string"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "position",
          "title",
          "category",
          "category_label",
          "explanation"
        ],
        "title": "CheckCatalogItem",
        "type": "object"
      },
      "CheckCatalogOut": {
        "properties": {
          "categories": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Categories",
            "type": "object"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/CheckCatalogItem"
            },
            "title": "Checks",
            "type": "array"
          }
        },
        "required": [
          "checks",
          "categories"
        ],
        "title": "CheckCatalogOut",
        "type": "object"
      },
      "CheckResultOut": {
        "properties": {
          "category": {
            "enum": [
              "address",
              "journey",
              "reputation",
              "behavior"
            ],
            "title": "Category",
            "type": "string"
          },
          "category_label": {
            "title": "Category Label",
            "type": "string"
          },
          "duration_ms": {
            "default": 0,
            "title": "Duration Ms",
            "type": "integer"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "facts": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/KeyValue"
            },
            "title": "Facts",
            "type": "array"
          },
          "findings": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/FindingOut"
            },
            "title": "Findings",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "limitation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limitation"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "risk_points": {
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Risk Points",
            "type": "integer"
          },
          "status": {
            "enum": [
              "clear",
              "notice",
              "warning",
              "danger",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "position",
          "title",
          "category",
          "category_label",
          "explanation",
          "status",
          "risk_points",
          "summary"
        ],
        "title": "CheckResultOut",
        "type": "object"
      },
      "Counts": {
        "properties": {
          "clear": {
            "title": "Clear",
            "type": "integer"
          },
          "flagged": {
            "title": "Flagged",
            "type": "integer"
          },
          "unverified": {
            "title": "Unverified",
            "type": "integer"
          }
        },
        "required": [
          "flagged",
          "clear",
          "unverified"
        ],
        "title": "Counts",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field"
          },
          "issue": {
            "title": "Issue",
            "type": "string"
          }
        },
        "required": [
          "issue"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FindingOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "evidence": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/KeyValue"
            },
            "title": "Evidence",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Severity",
            "type": "string"
          }
        },
        "required": [
          "severity",
          "code",
          "message"
        ],
        "title": "FindingOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "KeyValue": {
        "properties": {
          "key": {
            "title": "Key",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "key",
          "value"
        ],
        "title": "KeyValue",
        "type": "object"
      },
      "Progress": {
        "properties": {
          "done": {
            "title": "Done",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "done",
          "total"
        ],
        "title": "Progress",
        "type": "object"
      },
      "ScanOut": {
        "properties": {
          "checks": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/CheckResultOut"
            },
            "title": "Checks",
            "type": "array"
          },
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "counts": {
            "$ref": "#/components/schemas/Counts"
          },
          "coverage_percent": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coverage Percent"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Text"
          },
          "engine_version": {
            "title": "Engine Version",
            "type": "string"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "final_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Final Url"
          },
          "headline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Headline"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "normalized_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Normalized Url"
          },
          "progress": {
            "$ref": "#/components/schemas/Progress"
          },
          "reasons": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          },
          "risk_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Risk Score"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          },
          "submitted_input": {
            "title": "Submitted Input",
            "type": "string"
          },
          "verdict": {
            "anyOf": [
              {
                "enum": [
                  "safe",
                  "caution",
                  "suspicious",
                  "dangerous",
                  "inconclusive"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verdict"
          }
        },
        "required": [
          "id",
          "status",
          "submitted_input",
          "progress",
          "counts",
          "created_at",
          "expires_at",
          "engine_version"
        ],
        "title": "ScanOut",
        "type": "object"
      },
      "SubmitScanRequest": {
        "additionalProperties": false,
        "properties": {
          "display_text": {
            "anyOf": [
              {
                "maxLength": 1000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional: the visible label the link had (e.g. 'Click here for the official portal').",
            "title": "Display Text"
          },
          "url": {
            "description": "The link to analyse, exactly as received. Any string is accepted, including javascript: and data: links; it is analysed, never executed.",
            "maxLength": 4096,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "SubmitScanRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Unmask Link Security API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/checks": {
      "get": {
        "operationId": "list_checks_api_v1_checks_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckCatalogOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The 20 tests and what each one does",
        "tags": [
          "scans"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "operationId": "live_api_v1_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness: the process is running",
        "tags": [
          "operations"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness: database and schema are usable",
        "tags": [
          "operations"
        ]
      }
    },
    "/api/v1/scans": {
      "post": {
        "operationId": "submit_scan_api_v1_scans_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitScanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Submit a link for analysis",
        "tags": [
          "scans"
        ]
      }
    },
    "/api/v1/scans/{scan_id}": {
      "delete": {
        "operationId": "delete_scan_api_v1_scans__scan_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "scan_id",
            "required": true,
            "schema": {
              "title": "Scan Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete a report now",
        "tags": [
          "scans"
        ]
      },
      "get": {
        "operationId": "read_scan_api_v1_scans__scan_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "scan_id",
            "required": true,
            "schema": {
              "title": "Scan Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          }
        },
        "summary": "Read a report (poll until status is completed)",
        "tags": [
          "scans"
        ]
      }
    }
  }
}
